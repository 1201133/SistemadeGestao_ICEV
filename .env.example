# ========================================
# CONFIGURAÇÃO DE SEGURANÇA
# ========================================
# IMPORTANTE: Renomeie este arquivo para .env antes de usar
# NUNCA compartilhe o arquivo .env com suas senhas reais
# O arquivo .env deve estar no .gitignore para não ser enviado ao GitHub

# ========================================
# HASHES DE SENHAS DOS USUÁRIOS
# ========================================
# As senhas são armazenadas como hashes bcrypt para segurança
# Use o script generate_password_hash.py para gerar novos hashes
# 
# Exemplo de uso:
#   python generate_password_hash.py
#
# HASHES DE EXEMPLO PARA TESTE (TROQUE EM PRODUÇÃO!):
# Senhas de exemplo para testar o sistema:
#   admin: SENHA_ADMIN_EXEMPLO
#   diacono01: SENHA_DIACONO01_EXEMPLO
#   diacono02: SENHA_DIACONO02_EXEMPLO
#   diacono03: SENHA_DIACONO03_EXEMPLO

# Hash para o usuário admin (senha exemplo: SENHA_ADMIN_EXEMPLO)
USER_ADMIN_HASH=$2b$12$SEU_HASH_ADMIN_GERADO_AQUI................................

# Hash para o usuário diacono01 (senha exemplo: SENHA_DIACONO01_EXEMPLO)
USER_DIACONO01_HASH=$2b$12$SEU_HASH_DIACONO01_GERADO_AQUI............................

# Hash para o usuário diacono02 (senha exemplo: SENHA_DIACONO02_EXEMPLO)
USER_DIACONO02_HASH=$2b$12$SEU_HASH_DIACONO02_GERADO_AQUI............................

# Hash para o usuário diacono03 (senha exemplo: SENHA_DIACONO03_EXEMPLO)
USER_DIACONO03_HASH=$2b$12$SEU_HASH_DIACONO03_GERADO_AQUI............................

# Habilitar funcionalidade WhatsApp (true/false)
WHATSAPP_ENABLED=false

# ========================================
# CONFIGURAÇÕES DE EMAIL (NEWSLETTER)
# ========================================

# Habilitar envio de e-mail da newsletter (true/false)
SMTP_ENABLED=false

# Servidor SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Credenciais SMTP
SMTP_USER=seu_email@provedor.com
SMTP_PASSWORD=sua_senha_ou_token_app

# Remetente exibido no e-mail
SMTP_FROM_NAME=Ministerio Dehomai
SMTP_FROM_EMAIL=seu_email@provedor.com

# ========================================
# CONFIGURAÇÕES RAPIDAPI (CORRETOR ORTOGRÁFICO)
# ========================================

# API de correção ortográfica usada na Newsletter (Resumo e Mensagem completa)
JSPELL_API_URL=https://jspell-checker.p.rapidapi.com/check
JSPELL_API_HOST=jspell-checker.p.rapidapi.com
JSPELL_API_KEY=sua_chave_rapidapi_aqui
JSPELL_TIMEOUT_SECONDS=20

# ========================================
# INSTRUÇÕES:
# ========================================
# 1. Copie este arquivo e renomeie para .env
# 2. Substitua os valores acima pelas suas credenciais
# 3. Para newsletter por e-mail, configure SMTP_* e defina SMTP_ENABLED=true
# 4. Para corretor ortográfico da Newsletter, configure JSPELL_API_KEY
